# Allow all source and documentation files
!**/*.dart
!/Docs/*

# Model files (keep ONNX for card detection)
*.pt
*.pth
*.h5
*.pb
*.tflite
saved_model/

# Keep ONNX models
!assets/models/*.onnx

# Logs
*.log
*_log.txt
analysis_output.txt
error*.txt
build*.txt
pub_get*.txt
calibration_logs*.txt
devices*.txt
doctor.txt
test_*.txt
run_*.txt
flutter_*.log

# Temp test data
scripts/*.npy

# MacOS
.DS_Store
.AppleDouble
.LSOverride

# Exceptions to above rules.
!/packages/flutter_tools/test/data/dart_dependencies_test/**/.packages
!/dev/ci/**/Gemfile.lock

# Keep these important files
!pubspec.yaml
!pubspec.lock
!analysis_options.yaml
!.gitignore
!.metadata
